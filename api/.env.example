# Salin ke .env lalu isi. Jangan commit .env / .env.prod.
# Dua database terpisah:
#   .env       -> Supabase dev/tes (Tokyo, kwsdjpxlvmjxlqmvbylf), ENVIRONMENT=development. Dipakai pytest & server lokal.
#   .env.prod  -> Supabase produksi (Singapura, xcksxhiablzenpiwkkak), ENVIRONMENT=production.
#                 Hanya untuk operasi sengaja: RERUPA_ENV_FILE=.env.prod uv run python scripts/import_collection.py ...
# Railway tidak memakai file ini; variabelnya diisi di Settings tiap service (menunjuk ke Singapura).
# pytest menolak berjalan bila ENVIRONMENT=production.
# Jangan jalankan worker lokal saat pytest berjalan: worker itu ikut mengambil job tes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# OpenAI — model dipilih lewat uji (eval/HASIL_UJI_MODEL.md). Harga = USD per 1 juta token (wajib, untuk batas biaya)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.1-terra
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_PRICE_INPUT_PER_M=1.0
OPENAI_PRICE_OUTPUT_PER_M=5.0
OPENAI_REASONING_EFFORT=low

DAILY_AI_BUDGET_USD=5
CHECKPOINT_COUNT=2
LINEART_METHOD=teed
LINEART_METHOD_COLLECTION=model
MASK_MODEL=u2net
FRONTEND_ORIGIN=http://localhost:3000
FEATURE_STORY=false
FEATURE_RECOGNITION=false
# Model gambar panel storyline (harga token gambar per 1 juta)
OPENAI_IMAGE_MODEL_DRAFT=gpt-image-2.6-flare
OPENAI_IMAGE_MODEL_FINAL=gpt-image-2.6-sunburst
OPENAI_IMAGE_PRICE_INPUT_PER_M=8
OPENAI_IMAGE_PRICE_OUTPUT_PER_M=30
STORY_MAX_WEB_SEARCHES=3

# --- Produksi (Railway/Fly) ---
# ENVIRONMENT=production menolak start bila konfigurasi berbahaya (lihat DEPLOY.md)
ENVIRONMENT=development
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
EXPOSE_DOCS=true
# Domain Vercel dipisah koma; preview Vercel lewat regex (opsional)
FRONTEND_ORIGIN_REGEX=

# Rate limit per proses API (0 = nonaktif)
RATE_LIMIT_PER_IP_MINUTE=600
RATE_LIMIT_PER_SESSION_MINUTE=180
RATE_LIMIT_SESSIONS_PER_IP_HOUR=60
RATE_LIMIT_UPLOADS_PER_IP_HOUR=80

# Batas tunggu job (detik sejak dibuat) + toleransi
GENERATE_DEADLINE_SECONDS=60
FEEDBACK_DEADLINE_SECONDS=45
DEADLINE_GRACE_SECONDS=15

# Akun: email (dipisah koma) yang otomatis jadi admin setelah emailnya terverifikasi.
ADMIN_EMAILS=
