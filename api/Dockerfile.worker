# Image worker CV: torch CPU + rembg + controlnet-aux + bobot model tertanam.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    HF_HOME=/app/.cache/huggingface \
    U2NET_HOME=/app/.cache/u2net \
    OMP_NUM_THREADS=2

# libgomp1: onnxruntime/torch (CPU), libglib2.0-0: opencv
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /usr/local/bin/uv
WORKDIR /app

# 1) Dependensi (berubah jarang)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group cv --no-group dev --no-install-project

# 2) Bobot model (±350 MB) — SEBELUM kode, supaya perubahan kode tidak mengunduh ulang model.
#    Tetapkan HF_TOKEN sebagai build arg di Railway bila Hugging Face membatasi unduhan tanpa token.
COPY scripts/fetch_models.py ./scripts/fetch_models.py
RUN uv run --no-sync python scripts/fetch_models.py
ENV HF_HUB_OFFLINE=1

# 3) Kode aplikasi (berubah sering)
COPY . .
RUN useradd --create-home --uid 10001 rerupa && chown -R rerupa /app
USER rerupa
ENV PATH="/app/.venv/bin:$PATH"
# SIGTERM ditangani worker: job berjalan diselesaikan dulu (atur draining Railway ≥60 s).
CMD ["python", "worker.py"]
